{
  "name": "inky-frame-server-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "frontend:dev": "PORT=${FRONTEND_PORT:-3010} bun --cwd frontend run dev",
    "backend:dev": "PORT=${BACKEND_PORT:-3011} FRONTEND_PORT=${FRONTEND_PORT:-3010} bun --cwd backend run start:dev",
    "install:all": "bun install",
    "tunnel": "cloudflared tunnel --config config.yaml run",
    "lint": "oxlint && biome lint .",
    "lint:oxlint": "oxlint",
    "lint:biome": "biome lint .",
    "lint:fix": "oxlint --fix && biome check --write .",
    "format": "biome format --write .",
    "coverage": "bun --cwd backend run test:cov && sed -i 's|^SF:src/|SF:backend/src/|' backend/coverage/lcov.info",
    "sonar": "sonar-scanner-npm"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sonar/scan": "^5",
    "oxlint": "^1.88.0"
  }
}
